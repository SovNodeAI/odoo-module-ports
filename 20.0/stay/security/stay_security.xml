<odoo>
    <data noupdate="0">
        <record id="module_category_stay" model="ir.module.category">
            <field name="name">Stay</field>
            <field name="description">Manage stays (lunch, diner, night, etc...)</field>
            <field name="sequence">50</field>
        </record>

        <record id="res_groups_privilege_stay" model="res.groups.privilege">
            <field name="name">Stay</field>
            <field name="category_id" ref="module_category_stay" />
        </record>

        <record id="group_stay_viewer" model="res.groups">
            <field name="name">Viewer</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_stay" />
        </record>

        <record id="group_stay_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_stay" />
            <field name="implied_ids" eval="[(4, ref('group_stay_viewer'))]" />
        </record>

        <record id="group_stay_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_stay" />
            <field name="implied_ids" eval="[(4, ref('group_stay_user'))]" />
            <field name="user_ids" eval="[(4, ref('base.user_root'))]" />
        </record>

        <record id="group_stay_breakfast" model="res.groups">
            <field name="name">Manage Breakfast</field>
        </record>
        <record id="group_stay_picnic" model="res.groups">
            <field name="name">Manage Picnic</field>
        </record>
        <record id="group_stay_group" model="res.groups">
            <field name="name">Manage Stay Groups</field>
        </record>
    </data>

    <data noupdate="1">
        <record id="base.default_user_group" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_stay_user'))]" />
        </record>

        <record id="base.user_admin" model="res.users">
            <field name="group_ids" eval="[(4, ref('group_stay_manager'))]" />
        </record>

        <record id="base.user_root" model="res.users">
            <field name="group_ids" eval="[(4, ref('group_stay_manager'))]" />
        </record>

        <!-- Multi-company rules are defined in ir.access.csv -->
    </data>
</odoo>
