<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Since Odoo 20, record rules (ir.rule) are merged into ir.access.
    A row without a group is a restriction, AND-ed for every user. -->
    <record id="helpdesk_sla_comp_rule" model="ir.access">
        <field name="name">Helpdesk SLA Company Rule</field>
        <field name="model_id" ref="model_helpdesk_sla" />
        <field name="operation">crud</field>
        <field name="domain">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
