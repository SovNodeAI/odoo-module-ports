<templates xml:space="preserve">

    <t t-name="social_media_base.SocialMessage">
        <div class="o_social_message_block">
            <div
                t-ref="this.textRef"
                t-attf-class="o_social_message {{ this.props.className }} {{ this.state.expanded ? this.expandedClass : '' }}"
                t-attf-style="--o-social-message-lines: {{ this.props.lines }}"
                t-esc="this.props.text"
            />
            <span
                t-if="this.state.overflowing"
                class="cursor-pointer show-more-message"
                t-on-click.stop="this.onToggle"
                t-esc="this.toggleLabel"
            />
        </div>
    </t>

</templates>
