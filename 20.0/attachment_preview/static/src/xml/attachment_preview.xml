<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="Attachment" t-inherit="mail.AttachmentList" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-AttachmentButtons')]" position="inside">
            <t t-if="attachment.downloadUrl and this._canPreviewAttachment(attachment)">
                <button
                    class="btn btn-secondary"
                    t-att-data-id="attachment.id"
                    t-att-data-url="attachment.defaultSource"
                    t-on-click.stop="(ev) => this._onPreviewAttachment(attachment, ev)"
                    t-att-data-original-title="attachment.name"
                    t-attf-title="Preview {{attachment.name}} in side panel"
                >
                    <i class="oi" data-icon="search" role="img" aria-label="Preview" />
                </button>
                <button
                    class="btn btn-secondary"
                    data-target="new"
                    t-att-data-id="attachment.id"
                    t-att-data-url="attachment.defaultSource"
                    t-on-click.stop="(ev) => this._onPreviewAttachment(attachment, ev)"
                    t-att-data-original-title="attachment.name"
                    t-attf-title="Open preview {{attachment.name}} in a new tab"
                >
                    <i
                        class="oi" data-icon="open_in_new"
                        role="img"
                        aria-label="Open in new page"
                    />
                </button>
            </t>
        </xpath>
    </t>

    <t t-name="attachment_preview.AttachmentPreviewWidget">
        <div class="attachment_preview_widget d-none" t-ref="this.rootRef">
            <div class="attachment_preview_buttons">
                <div class="button-group pull-left">
                    <button
                        class="btn btn-sm btn-secondary attachment_preview_previous"
                        t-on-click="_onPreviousClick"
                    >
                        <i class="oi" data-icon="chevron_left" />
                    </button>
                    <button
                        class="btn btn-sm btn-secondary disabled attachment_preview_current"
                        t-ref="this.currentRef"
                    >1 / 5</button>
                    <button
                        class="btn btn-sm btn-secondary attachment_preview_next"
                        t-on-click="_onNextClick"
                    >
                        <i class="oi" data-icon="chevron_right" />
                    </button>
                </div>
                <button
                    class="btn btn-sm btn-secondary pull-left ml8 attachment_preview_popout"
                    t-on-click="_onPopoutClick"
                >
                    <i class="oi" data-icon="open_in_new" />
                </button>
                <button
                    class="btn btn-sm btn-secondary pull-right attachment_preview_close"
                    t-on-click="_onCloseClick"
                >
                    <i class="oi" data-icon="close" />
                </button>
            </div>
            <iframe class="attachment_preview_iframe" t-ref="this.iframeRef" />
        </div>
    </t>
</templates>
