<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form inherit RMA return</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field
                    name="create_rma"
                    invisible="not return_id or picking_type_code not in ('outgoing', 'dropship')"
                />
                <field name="rma_operation_id" invisible="not create_rma" />
            </field>
            <xpath expr="//field[@name='move_ids']//list" position="inside">
                <field
                    name="rma_operation_id"
                    required="parent.create_rma and product_uom_qty>0"
                    column_invisible="not parent.create_rma"
                />
                <field
                    name="return_product_id"
                    column_invisible="not parent.create_rma"
                    invisible="not different_return_product"
                    required="different_return_product and product_uom_qty>0"
                />
            </xpath>
        </field>
    </record>
</odoo>
