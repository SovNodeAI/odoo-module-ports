<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t
        t-name="mail_gateway.ChatterTopbar"
        t-inherit="mail.Chatter"
        t-inherit-mode="extension"
    >
        <xpath expr="//button[hasclass('o-mail-Chatter-logNote')]" position="after">
            <button
                class="o-mail-Chatter-gateway btn text-nowrap"
                type="button"
                t-if="this.hasGatewayGroup"
                t-att-class="{
                    'btn-primary active': this.state.composerType === 'gateway',
                    'btn-secondary': this.state.composerType !== 'gateway'
                }"
                t-on-click="() => this.toggleComposer('gateway')"
                data-hotkey="shift+w"
            >
                <i class="oi" data-icon="travel" role="img" aria-label="gateway" />
                <span> Gateway</span>
            </button>
        </xpath>
        <xpath expr="//t[@t-if='this.state.composerType']/Composer" position="before">
            <t
                t-if="this.state.composerType === 'gateway' and this.state.thread.gateway_followers.length"
            >
                <div
                    class="flex-shrink-0 px-3 pt-3 text-truncate small mb-2"
                    style="margin-left:48px"
                >
                    <span class="fw-bold">To:</span>
                    <t
                        t-foreach="this.state.thread.gateway_followers"
                        t-as="gateway_follower"
                        t-key="gateway_follower.id"
                    >
                        <GatewayFollower
                            follower="gateway_follower"
                            composer="this.state.thread.composer"
                        />
                    </t>
                </div>
            </t>
        </xpath>
    </t>
</templates>
