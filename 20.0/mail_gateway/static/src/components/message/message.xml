<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-inherit="mail.Message" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Message-header')]" position="inside">
            <small
                t-if="this.message.gateway_thread_data"
                t-on-click.prevent="this.openGatewayThreadRecord"
                class="o-mail-Gateway-thread-link ms-1 text-500"
            >
                <t t-if="this.message.gateway_thread_data.model !== 'discuss.channel'">
                    on <a t-att-href="this.message.resUrl">
                        <t t-esc="this.message.gateway_thread_data?.name" />
                    </a>
                </t>
            </small>
        </xpath>
    </t>
</templates>
