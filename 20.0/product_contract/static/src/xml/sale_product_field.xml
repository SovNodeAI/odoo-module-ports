<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-inherit="sale.SaleProductField" t-inherit-mode="extension">
        <xpath expr="//button[@t-on-click='() =&gt; this.onEditConfiguration()']" position="after">
            <t t-if="isConfigurableContract">
                <button
                    type="button"
                    class="oi oi-filled o_configuration_button btn btn-link text-action p-0 small d-print-none"
                    data-icon="edit_square"
                    tabindex="-1"
                    draggable="false"
                    aria-label="Configure contract"
                    data-tooltip="Configure contract"
                    t-on-click="() => this.onEditContractConfiguration()"
                />
            </t>
        </xpath>
    </t>

</templates>
