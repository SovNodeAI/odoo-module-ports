<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="account_billing_company_rule" model="ir.access">
        <field name="name">Account Billing Multi-company</field>
        <field name="model_id" ref="model_account_billing" />
        <field name="operation">crud</field>
        <field
            name="domain"
        >['|', ('company_id', 'in', company_ids), ('company_id', '=', False)]</field>
    </record>
    <record id="account_billing_line_company_rule" model="ir.access">
        <field name="name">Account Billing Line Multi-company</field>
        <field name="model_id" ref="model_account_billing_line" />
        <field name="operation">crud</field>
        <field
            name="domain"
        >['|', ('billing_id.company_id', 'in', company_ids), ('billing_id.company_id', '=', False)]</field>
    </record>
</odoo>
