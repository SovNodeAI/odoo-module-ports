<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="delivery_sendcloud_oca.ServicePointField">
        <div class="o_delivery_sendcloud_widget">
            <div class="input-group">
                <div class="form-control o_delivery_sendcloud_detail">
                    <div>
                        <t t-out="this.sp_name" />
                    </div>
                    <div>
                        <t t-out="this.street" />
                        <t t-out="this.house_number" />
                    </div>
                    <div>
                        <t t-out="this.postal_code" />
                    </div>
                    <div>
                        <t t-out="this.city" />
                    </div>
                </div>
                <div class="input-group-append">
                    <button
                        class="btn btn-primary o_delivery_sendcloud_select"
                        title="Select"
                        t-on-click="this.onInputClick"
                    >
                        <i class="fa fa-map-marker" />
                    </button>
                    <button
                        t-if="this.props.record.data[this.props.name]"
                        title="Clear"
                        class="btn btn-secondary o_delivery_sendcloud_clear"
                        t-on-click="this.onClearClick"
                    >
                        <i class="fa fa-times" />
                    </button>
                </div>
            </div>
        </div>
    </t>

</templates>
