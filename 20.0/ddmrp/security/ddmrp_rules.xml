<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="0">
    <!-- In Odoo 20, record rules (ir.rule) have been merged into ir.access:
    a record without group and with a domain is a restriction. -->
    <record model="ir.access" id="stock_buffer_profile_variability_comp_rule">
        <field name="name">Buffer Profile Variability multi-company</field>
        <field name="model_id" ref="model_stock_buffer_profile_variability" />
        <field name="operation">crud</field>
        <field
            name="domain"
        >['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>
