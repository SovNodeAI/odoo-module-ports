<odoo noupdate="1">
    <!-- In Odoo 20, record rules (ir.rule) have been merged into ir.access:
    a record without group and with a domain is a restriction. -->
    <record id="account_banking_mandate_rule" model="ir.access">
        <field name="name">Banking Mandate multi-company</field>
        <field name="model_id" ref="model_account_banking_mandate" />
        <field name="operation">crd</field>
        <field
            name="domain"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
