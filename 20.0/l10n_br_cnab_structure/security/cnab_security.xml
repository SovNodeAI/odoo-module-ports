<odoo noupdate="1">
    <record id="module_privilege_cnab_constructor" model="res.groups.privilege">
        <field name="name">CNAB Structure</field>
        <field
            name="category_id"
            ref="l10n_br_account_payment_order.module_category_cnab"
        />
    </record>

    <record id="group_cnab_constructor" model="res.groups">
        <field name="name">CNAB Constructor</field>
        <field name="privilege_id" ref="module_privilege_cnab_constructor" />
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[Command.link(ref('group_cnab_constructor'))]" />
    </record>

    <record id="base.group_system" model="res.groups">
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_cnab_constructor'))]"
        />
    </record>
</odoo>
