<odoo>
    <template id="signup_fields" inherit_id="auth_signup.fields">
        <xpath expr="//div[hasclass('field-password')]" position="attributes">
            <attribute name="t-if">only_passwords</attribute>
        </xpath>
        <xpath expr="//div[hasclass('field-confirm_password')]" position="attributes">
            <attribute name="t-if">only_passwords</attribute>
        </xpath>
    </template>
    <template id="signup_login" inherit_id="auth_signup.signup">
        <xpath expr="//input[@name='login']" position="attributes">
            <attribute name="type">email</attribute>
        </xpath>
        <xpath expr="//t[@t-call='auth_signup.fields']" position="attributes">
            <attribute name="only_passwords">bool(token and not invalid_token)</attribute>
        </xpath>
    </template>
    <template id="reset_password_login" inherit_id="auth_signup.reset_password">
        <xpath expr="//input[@name='login']" position="attributes">
            <attribute name="type">email</attribute>
        </xpath>
        <xpath expr="//t[@t-call='auth_signup.fields']" position="attributes">
            <attribute name="only_passwords">1</attribute>
        </xpath>
    </template>
</odoo>
