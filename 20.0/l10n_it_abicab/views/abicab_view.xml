<?xml version="1.0" ?>
<odoo>
    <record id="view_bank_filter_abicab" model="ir.ui.view">
        <field name="name">res.partner.bank.filter.abicab</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_search" />
        <field name="arch" type="xml">
            <field name="bank_name" position="after">
                <field name="abi" />
                <field name="cab" />
            </field>
        </field>
    </record>

    <record id="view_bank_list_abicab" model="ir.ui.view">
        <field name="name">res.partner.bank.list.abicab</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_tree" />
        <field name="arch" type="xml">
            <field name="bank_name" position="after">
                <field name="abi" optional="hide" />
                <field name="cab" optional="hide" />
            </field>
        </field>
    </record>

    <record id="view_partner_bank_form_abicab_form" model="ir.ui.view">
        <field name="name">res.partner.bank.form.abicab</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_form" />
        <field name="arch" type="xml">
            <field name="bank_name" position="after">
                <field name="abi" />
                <field name="cab" />
            </field>
        </field>
    </record>
</odoo>
