<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="group_use_agreement_rebate" model="res.groups">
        <field name="name">Use agreement rebate</field>
    </record>
    <data noupdate="1">
        <record id="agreement_rebate_settlement_comp_rule" model="ir.access">
            <field name="name">Rebate settlement multi-company</field>
            <field name="model_id" ref="model_agreement_rebate_settlement"/>
            <field name="group_id" ref="group_use_agreement_rebate"/>
            <field name="operation">crud</field>
            <field name="domain">[('company_id', 'in', [False] + company_ids)]</field>
        </record>
        <record id="agreement_rebate_settlement_line_comp_rule" model="ir.access">
            <field name="name">Rebate settlement line multi-company</field>
            <field name="model_id" ref="model_agreement_rebate_settlement_line"/>
            <field name="group_id" ref="group_use_agreement_rebate"/>
            <field name="operation">crud</field>
            <field name="domain">[('company_id', 'in', [False] + company_ids)]</field>
        </record>
        <record id="agreement_rebate_settlement_user_comp_rule" model="ir.access">
            <field name="name">Rebate settlement multi-company read</field>
            <field name="model_id" ref="model_agreement_rebate_settlement"/>
            <field name="group_id" ref="base.group_user"/>
            <field name="operation">r</field>
            <field name="domain">[('company_id', 'in', [False] + company_ids)]</field>
        </record>
        <record id="agreement_rebate_settlement_line_user_comp_rule" model="ir.access">
            <field name="name">Rebate settlement line multi-company read</field>
            <field name="model_id" ref="model_agreement_rebate_settlement_line"/>
            <field name="group_id" ref="base.group_user"/>
            <field name="operation">r</field>
            <field name="domain">[('company_id', 'in', [False] + company_ids)]</field>
        </record>
    </data>
</odoo>
