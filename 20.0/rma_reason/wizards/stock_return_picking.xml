<odoo>
    <record model="ir.ui.view" id="stock_return_picking_form_view">
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="rma_reason_id" invisible="not create_rma" />
                <field name="rma_operation_domain" invisible="1" />
            </field>
            <xpath
                expr="//field[@name='move_ids']//list//field[@name='product_id']"
                position="before"
            >
                <field
                    name="rma_reason_id"
                    column_invisible="not parent.create_rma"
                    required="is_rma_reason_required and parent.create_rma and product_uom_qty>0"
                />
            </xpath>
        </field>
    </record>
</odoo>
