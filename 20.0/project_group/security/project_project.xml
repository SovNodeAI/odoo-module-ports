<odoo>
    <record model="ir.access" id="project_groups_rule">
        <field name="name">Project: employees: Groups</field>
        <field name="model_id" ref="project.model_project_project" />
        <field name="group_id" ref="base.group_user" />
        <field name="operation">crud</field>
        <field name="domain">[
                                        ('privacy_visibility', '=', 'followers'),
                                        ('group_ids', 'in', user.all_group_ids.ids)
                                    ]</field>
    </record>

    <record model="ir.access" id="project_task_groups_rule">
        <field name="name">Task: employees: Groups</field>
        <field name="model_id" ref="project.model_project_task" />
        <field name="group_id" ref="base.group_user" />
        <field name="operation">crud</field>
        <field name="domain">[
                                        ('project_id', '!=', False),
                                        ('project_id.privacy_visibility', '=', 'followers'),
                                        ('project_id.group_ids', 'in', user.all_group_ids.ids)
                                    ]</field>
    </record>
</odoo>
