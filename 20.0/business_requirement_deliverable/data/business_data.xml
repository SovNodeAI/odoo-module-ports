<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Security Group Category -->
    <record model="ir.module.category" id="module_category_business_requirement_cost">
        <field name="name">Business Requirement Cost</field>
        <field name="description" />
        <field name="sequence">10</field>
    </record>
    <record id="portal_entry_business_requirement_deliverable" model="portal.entry">
        <field name="name">Business Requirement Deliverables</field>
        <field name="description">Check the deliverables of your requirements</field>
        <field name="url">/my/brd</field>
        <field
            name="image"
            type="bytes"
            file="business_requirement_deliverable/static/img/deliverables.svg"
        />
        <field name="placeholder_count">dl_count</field>
        <field name="category">service_category</field>
    </record>
</odoo>
