<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="portal_my_home_delivery_note" model="portal.entry">
        <field name="name">Your Delivery Notes</field>
        <field
            name="image"
            type="bytes"
            file="l10n_it_delivery_note/static/src/img/DN.svg"
        />
        <field name="url">/my/delivery-notes</field>
        <field name="description">Follow or download your delivery notes</field>
        <field name="placeholder_count">dn_count</field>
        <field name="category">client_category</field>
        <field name="sequence" eval="50" />
    </record>
</odoo>
