<odoo>
    <record id="module_category_membership_management" model="ir.module.category">
        <field name="name">Membership</field>
        <field name="description">Helps you manage operations for managing memberships.</field>
        <field name="sequence">3</field>
    </record>
    <record model="res.groups.privilege" id="res_groups_privilege_membership_management">
        <field name="name">Membership</field>
        <field name="category_id" ref="module_category_membership_management"/>
    </record>
    <record id="group_membership_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_membership_management"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>
    </odoo>
