<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="report_maintenance_request_document"
        inherit_id="base_maintenance.report_maintenance_request_document"
    >
        <xpath expr="//div[@id='description']" position="after">
            <div class="row mt32 mb32" id="note">
                <!-- TODO: Add support for other instruction types using QRCODE/links
                    - PDF: embed or link to the PDF file (share attachment)
                    - Google Slide: link to the Google Slide presentation
                -->
                <div
                    t-if="doc.instruction_text"
                    class="col-auto mw-100 mb-2"
                >
                    <strong>Instructions:</strong>
                    <div class="m-0" t-field="doc.instruction_text" />
                </div>
            </div>
        </xpath>
        <!-- Odoo 20 replaced the technician `user_id` by `user_ids`. -->
        <xpath expr="//t[@t-set='doc']" position="attributes">
            <attribute
                name="t-value"
            >doc.with_context(lang=(doc.user_ids[:1].partner_id.lang or doc.owner_user_id.partner_id.lang))</attribute>
        </xpath>
        <xpath expr="//div[@t-if='doc.user_id']" position="attributes">
            <attribute name="t-if">doc.user_ids</attribute>
        </xpath>
        <xpath expr="//div[@t-if='doc.user_ids']/p[@t-field='doc.user_id']" position="attributes">
            <attribute name="t-field">doc.user_ids</attribute>
        </xpath>
        <!-- Odoo 20 removed `request_date`; use the scheduled date instead. -->
        <xpath expr="//div[@t-if='doc.request_date']" position="attributes">
            <attribute name="t-if">doc.schedule_date</attribute>
        </xpath>
        <xpath
            expr="//div[@t-if='doc.schedule_date']/p[@t-field='doc.request_date']"
            position="attributes"
        >
            <attribute name="t-field">doc.schedule_date</attribute>
        </xpath>
    </template>

    <template
        id="report_maintenance_request"
        inherit_id="base_maintenance.report_maintenance_request"
    >
        <xpath
            expr="//t[@t-call='base_maintenance.report_maintenance_request_document']"
            position="attributes"
        >
            <attribute
                name="t-lang"
            >(doc.user_ids[:1].partner_id.lang or doc.owner_user_id.partner_id.lang)</attribute>
        </xpath>
    </template>
</odoo>
