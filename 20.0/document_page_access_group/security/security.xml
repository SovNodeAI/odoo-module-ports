<odoo noupdate="1">
    <record id="document_page_rule" model="ir.access">
        <field name="name">Document Page Access</field>
        <field name="model_id" ref="model_document_page" />
        <field name="group_id" ref="document_knowledge.group_document_user" />
        <field name="operation">r</field>
        <field
            name="domain"
        >['|', ('groups_id', 'in', user.all_group_ids.ids), '|', ('user_ids', 'in', [user.id]), '&amp;', ('groups_id', '=', False), ('user_ids', '=', False)]</field>
    </record>
    <record id="document_page.document_page_user" model="ir.access">
        <field name="domain">[(0, '=', 1)]</field>
    </record>
    <record id="document_page_rule_full_access" model="ir.access">
        <field name="active" eval="False" />
        <field name="name">Document Page Full Access</field>
        <field name="model_id" ref="model_document_page" />
        <field name="group_id" ref="document_page.group_document_manager" />
        <field name="operation">crud</field>
    </record>
</odoo>
