<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="base_tier_validation.ReviewMenu">
        <Dropdown position="'bottom-end'" state="dropdown">
            <button
                class="o_tier_navbar_item"
                t-att-class="{'o_no_notification': !state.reviewCounter}"
                title="Reviews"
            >
                <i class="fa fa-pencil-square-o" role="img" aria-label="Reviews" />
                <span
                    t-if="state.reviewCounter"
                    class="o_notification_counter badge rounded-pill"
                >
                    <t t-out="state.reviewCounter" />
                </span>
            </button>
            <t t-set-slot="content">
                <div class="o_tier_systray_dropdown">
                    <div class="o_tier_systray_dropdown_items">
                        <t t-if="!state.reviews.length">
                            <div class="o_no_activity text-center p-2">
                                <span>No reviews to do.</span>
                            </div>
                        </t>
                        <t t-foreach="state.reviews" t-as="review" t-key="review.model">
                            <div
                                class="o_mail_preview o_tier_preview"
                                t-att-data-res_model="review.model"
                                t-att-data-model_name="review.name"
                                t-att-data-active_field="review.active_field"
                                t-on-click="() => this._onReviewFilterClick(review)"
                            >
                                <div class="o_mail_preview_image o_mail_preview_app">
                                    <img t-att-src="review.icon" alt="Review" />
                                </div>
                                <div class="o_preview_info">
                                    <div class="o_preview_title">
                                        <span
                                            class="o_preview_name"
                                            t-out="review.name"
                                        />
                                    </div>
                                    <div>
                                        <span
                                            t-if="review.pending_count"
                                            class="btn btn-link o_activity_filter_button"
                                        >
                                            <t t-out="review.pending_count" />
                                            Pending
                                        </span>
                                        <span
                                            t-if="!review.pending_count"
                                            class="o_no_activity"
                                        >
                                            0 Pending
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </t>
        </Dropdown>
    </t>
</templates>
