<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="tier_validation_buttons">
        <div>
            <field name="validation_status" invisible="1" />
            <button
                name="request_validation"
                string="Request Validation"
                t-attf-invisible="not need_validation or validation_status in ['pending', 'rejected'] or #{state_field} #{state_operator} #{state_value}"
                type="object"
            />
            <button
                name="restart_validation"
                string="Restart Validation"
                t-attf-invisible="not review_ids or #{state_field} #{state_operator} #{state_value}"
                type="object"
            />
            <button
                name="reevaluate_reviews"
                string="Reevaluate Reviews"
                t-attf-invisible="not is_reevaluation_required or #{state_field} #{state_operator} #{state_value}"
                type="object"
            />
        </div>
    </template>
    <template id="tier_validation_label">
        <div>
            <field name="need_validation" invisible="1" />
            <field name="is_reevaluation_required" invisible="1" />
            <field name="validation_status" invisible="1" />
            <div
                class="alert alert-warning mb-0 pb-1 px-4"
                role="alert"
                t-attf-invisible="validation_status == 'validated' or #{state_field} #{state_operator} #{state_value} or validation_status == 'rejected' or not review_ids"
            >
                <p>
                    <i class="fa fa-info-circle" /> This Record needs to be validated.
                    <field name="can_review" invisible="1" />
                    <button
                        name="validate_tier"
                        string="Validate"
                        invisible="not can_review"
                        type="object"
                        class="btn-sm btn-success mx-1"
                        icon="fa-thumbs-up"
                    />
                    <button
                        name="reject_tier"
                        string="Reject"
                        invisible="not can_review"
                        type="object"
                        class="btn-sm btn-danger mx-1"
                        icon="fa-thumbs-down"
                    />
                    <field name="next_review" readonly="1" class="float-end pt-1" />
                </p>
            </div>
            <div
                class="alert alert-success mb-0 pb-1 px-4"
                role="alert"
                t-attf-invisible="validation_status != 'validated' or #{state_field} #{state_operator} #{state_value} or not review_ids"
            >
                <p>
                    <i class="fa fa-thumbs-up" /> Operation has been <b>validated</b>!
                </p>
            </div>
            <div
                class="alert alert-danger mb-0 pb-1 px-4"
                role="alert"
                t-attf-invisible="validation_status != 'rejected' or #{state_field} #{state_operator} #{state_value} or not review_ids"
            >
                <p>
                    <i class="fa fa-thumbs-down" /> Operation has been <b>rejected</b>.
                </p>
            </div>
        </div>
    </template>
    <template id="tier_validation_reviews">
        <field
            name="review_ids"
            widget="tier_validation"
            invisible="not review_ids"
            style="width:100%%; margin-top: 10px;"
        >
            <list>
                <field name="id" />
                <field name="name" />
                <field name="sequence" />
                <field name="requested_by" />
                <field name="status" />
                <field name="display_status" />
                <field name="todo_by" />
                <field name="done_by" />
                <field name="reviewed_date" />
                <field name="reviewed_formated_date" />
                <field name="comment" />
            </list>
        </field>
    </template>
</odoo>
