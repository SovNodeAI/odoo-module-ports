<odoo>
    <record id="view_users_form" model="ir.ui.view">
        <field name="name">Add firstname and surnames</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="readonly">True</attribute>
                <attribute name="required">False</attribute>
            </xpath>
            <!-- After the heading that holds the name, not after the email field: since
                 19.0 the email sits in a container of its own, which is hidden when the
                 login is the e-mail address (and, with hr, for users who are employees). -->
            <xpath expr="//h1[field[@name='name']]" position="after">
                <group>
                    <field name="lastname" required="not firstname" />
                    <field name="firstname" required="not lastname" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
